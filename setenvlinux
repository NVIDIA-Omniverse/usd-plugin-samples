if [ ! -d _venv ]; then
    $PWD/_build/usd-deps/python/python -m venv _venv
    source $PWD/_venv/bin/activate
    pip install PySide2
    pip install PyOpenGL
else
    source $PWD/_venv/bin/activate
fi

# if we are using NVIDIA pre-built binaries, use the prebuilt
# OpenUSD to set up the paths
# otherwise it's the devs responsibility to add those here
if [ -d $PWD/_build/usd-deps/usd ]; then
    export PYTHONPATH=$PYTHONPATH:$PWD/_build/usd-deps/usd/lib/python
    export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$PWD/_build/usd-deps/usd/bin:$PWD/_build/usd-deps/usd/lib:$PWD/_build/usd-deps/python
    export PATH=$PATH:$PWD/_build/usd-deps/usd/bin
fi

export PYTHONPATH=$PYTHONPATH:$PWD/_install
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$PWD/_install/bin:$PWD/_build/target-deps/zlib/lib/rt_dynamic/release
export PXR_PLUGINPATH_NAME=$PWD/_install/plugins/omniMetSchema/resources:$PWD/_install/plugins/edfFileFormat/resources:$PWD/_install/plugins/omniMetProvider/resources:$PWD/_install/plugins/omniExampleSchema/resources:$PWD/_install/plugins/omniExampleCodelessSchema/resources
